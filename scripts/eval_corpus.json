    {
      "id": "R02",
      "input": "cancel that, it was a purchase not a sale",
      "expected": {
        "action": "unknown",
        "note": "correction without amount context — model should clarify or return unknown"
      }
    },

    // ── Stock updates ─────────────────────────────────────────────────────────
    {
      "id": "T01",
      "input": "Restocked 20 kg of maize flour",
      "expected": {
        "action": "update_stock",
        "item": "maize flour",
        "quantity_delta": 20,
        "unit": "kg"
      }
    },
    {
      "id": "T02",
      "input": "Added 50 pieces of soap to inventory",
      "expected": {
        "action": "update_stock",
        "item": "soap",
        "quantity_delta": 50,
        "unit": "pieces"
      }
    },

    // ── Get health / summary ──────────────────────────────────────────────────
    {
      "id": "H01",
      "input": "What is my profit today?",
      "expected": {
        "action": "get_health"
      }
    },
    {
      "id": "H02",
      "input": "Give me a summary of today's business",
